#! /usr/bin/vvp
:ivl_version "12.0 (stable)";
:ivl_delay_selection "TYPICAL";
:vpi_time_precision - 12;
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/system.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_sys.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/vhdl_textio.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2005_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/va_math.vpi";
:vpi_module "/usr/lib/x86_64-linux-gnu/ivl/v2009.vpi";
S_0x5cf9e6b082b0 .scope package, "$unit" "$unit" 2 1;
 .timescale -9 -12;
S_0x5cf9e6b08440 .scope module, "imem" "imem" 3 1;
 .timescale -9 -12;
    .port_info 0 /INPUT 32 "read_address";
    .port_info 1 /OUTPUT 32 "instr";
L_0x5cf9e6b18d00 .functor BUFZ 32, L_0x5cf9e6b18b40, C4<00000000000000000000000000000000>, C4<00000000000000000000000000000000>, C4<00000000000000000000000000000000>;
v0x5cf9e6b09ad0_0 .net *"_ivl_0", 31 0, L_0x5cf9e6b18b40;  1 drivers
v0x5cf9e6b18750_0 .net *"_ivl_3", 29 0, L_0x5cf9e6b18c10;  1 drivers
v0x5cf9e6b18830_0 .net "instr", 31 0, L_0x5cf9e6b18d00;  1 drivers
v0x5cf9e6b188f0 .array "memory", 1023 0, 31 0;
o0x74c6960990a8 .functor BUFZ 32, C4<zzzzzzzzzzzzzzzzzzzzzzzzzzzzzzzz>; HiZ drive
v0x5cf9e6b189b0_0 .net "read_address", 31 0, o0x74c6960990a8;  0 drivers
L_0x5cf9e6b18b40 .array/port v0x5cf9e6b188f0, L_0x5cf9e6b18c10;
L_0x5cf9e6b18c10 .part o0x74c6960990a8, 2, 30;
S_0x5cf9e6b09940 .scope module, "cocotb_iverilog_dump" "cocotb_iverilog_dump" 4 1;
 .timescale -9 -12;
    .scope S_0x5cf9e6b09940;
T_0 ;
    %vpi_call/w 4 3 "$dumpfile", "sim_build/imem.fst" {0 0 0};
    %vpi_call/w 4 4 "$dumpvars", 32'sb00000000000000000000000000000000, S_0x5cf9e6b08440 {0 0 0};
    %end;
    .thread T_0;
